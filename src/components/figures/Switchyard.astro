---
// mailroom's sieve drawn as a switchyard ladder: one track in, a switch per
// question, a siding per bucket, and whatever no rule claims runs on to a person.
interface Props {
  class?: string;
  labels?: boolean;
}
const { class: className, labels = true } = Astro.props;

const mainY = 44;
const top = 74, step = 30;
const ladderX = (y: number) => 64 + (y - mainY) * 0.82;
const buckets = ["quarantine", "codes", "family", "jobs", "job alerts", "newsletters", "promotions"];
const sidings = buckets.map((name, i) => ({ name, y: top + i * step, x: ladderX(top + i * step) }));
const end = 372;
const lit = 3; // "jobs": the path drawn in the accent
const cars = [
  { y: top, x: 300 },
  { y: top + step, x: 330 },
  { y: top + step, x: 310 },
  { y: top + 2 * step, x: 340 },
  { y: top + 4 * step, x: 345 },
  { y: top + 4 * step, x: 325 },
  { y: top + 5 * step, x: 344 },
  { y: top + 5 * step, x: 324 },
  { y: top + 5 * step, x: 304 },
  { y: top + 6 * step, x: 330 },
  { y: mainY, x: 345 },
];
const litY = sidings[lit].y;
---

<svg class:list={["figure", className]} viewBox="0 0 480 300" role="img" aria-label="A rail yard: one incoming track with a switch for each question, seven sidings ending in buckets, and the main line running on to a person.">
  <line x1="16" y1={mainY} x2={end} y2={mainY} class="track" />
  <line x1={ladderX(mainY)} y1={mainY} x2={ladderX(sidings.at(-1)!.y)} y2={sidings.at(-1)!.y} class="track" />
  {
    sidings.map((s) => (
      <g>
        <line x1={s.x} y1={s.y} x2={end} y2={s.y} class="track" />
        <line x1={end} y1={s.y - 5} x2={end} y2={s.y + 5} class="bumper" />
        <circle cx={s.x} cy={s.y} r="3.5" class="node" />
      </g>
    ))
  }
  <line x1={end} y1={mainY - 5} x2={end} y2={mainY + 5} class="bumper" />
  <circle cx={ladderX(mainY)} cy={mainY} r="3.5" class="node" />

  <polyline points={`16,${mainY} ${ladderX(mainY)},${mainY} ${ladderX(litY)},${litY} 352,${litY}`} class="lit" />
  <circle cx={ladderX(litY)} cy={litY} r="3.5" class="node lit-node" />

  {cars.map((c) => <rect x={c.x - 7} y={c.y - 3.5} width="14" height="7" rx="1.5" class="car" />)}
  <rect x={352 - 7} y={litY - 3.5} width="14" height="7" rx="1.5" class="car lit-car" />
  <rect x={30 - 7} y={mainY - 3.5} width="14" height="7" rx="1.5" class="car lit-car" />

  {
    labels && (
      <g class="labels">
        <text x={end + 12} y={mainY + 4}>a person</text>
        {sidings.map((s, i) => (
          <text x={end + 12} y={s.y + 4} class={i === lit ? "lit-text" : undefined}>{s.name}</text>
        ))}
      </g>
    )
  }
</svg>

<style>
  .figure {
    width: 100%;
    height: auto;
    fill: none;
  }
  .figure :global(*) {
    vector-effect: non-scaling-stroke;
  }
  .track {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .bumper {
    stroke: var(--ink-2);
    stroke-width: 1.5;
  }
  .node {
    fill: var(--paper-raised);
    stroke: var(--ink-2);
    stroke-width: 1;
  }
  .lit {
    stroke: var(--accent);
    stroke-width: 1.75;
    fill: none;
  }
  .lit-node {
    stroke: var(--accent);
  }
  .car {
    fill: var(--ink-3);
  }
  .lit-car {
    fill: var(--accent);
  }
  .labels text {
    font-family: var(--mono);
    font-size: 10.5px;
    fill: var(--ink-3);
  }
  .labels .lit-text {
    fill: var(--accent);
  }
</style>
