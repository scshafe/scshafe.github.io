---
// Three sung phrases: the pitch on a staff, in the accent, over the waveform
// drawn as hairlines. The numbers are fixed (a seeded generator), so the
// drawing is the same on every build.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

const phrases = [
  { from: 30, to: 170, notes: [3, 2, 2.5, 1, 1.5] },
  { from: 196, to: 318, notes: [1, 0.5, 2, 3] },
  { from: 344, to: 452, notes: [2.5, 3.5, 2, 2.2] },
];
const staffTop = 52, staffGap = 15;
const noteY = (n: number) => staffTop + 4 * staffGap - n * staffGap;

// Waveform: a bar every 3.4 units, enveloped by each phrase.
const midY = 208, amp = 56;
const bars: { x: number; h: number }[] = [];
for (let x = 22; x <= 458; x += 3.4) {
  const p = phrases.find((q) => x >= q.from && x <= q.to);
  let h = 1.2 + rand() * 1.8;
  if (p) {
    const t = (x - p.from) / (p.to - p.from);
    const env = Math.sin(Math.PI * Math.min(1, t * 1.15)) ** 0.6;
    h = amp * env * (0.45 + 0.55 * rand());
  }
  bars.push({ x, h: Math.max(1.2, h) });
}

// Pitch: hold each note with a little vibrato, ease between them.
const contour = phrases.map((p) => {
  const seg = (p.to - p.from) / p.notes.length;
  const pts: string[] = [];
  for (let x = p.from; x <= p.to; x += 0.75) {
    const i = Math.min(p.notes.length - 1, Math.floor((x - p.from) / seg));
    const into = x - (p.from + i * seg);
    const prev = i > 0 ? p.notes[i - 1] : p.notes[0];
    const glide = Math.min(1, into / 9);
    const ease = 0.5 - 0.5 * Math.cos(Math.PI * glide);
    const n = prev + (p.notes[i] - prev) * ease;
    const onset = seg * 0.4;
    const vib = into > onset ? Math.sin((into - onset) * 0.6) * 1.3 * Math.min(1, (into - onset) / 14) : 0;
    pts.push(`${pts.length ? "L" : "M"}${x.toFixed(1)},${(noteY(n) + vib).toFixed(2)}`);
  }
  return pts.join(" ");
});
---

<svg class:list={["figure", className]} viewBox="0 0 480 300" role="img" aria-label="Three sung phrases: a pitch line moving across a musical staff, above a waveform drawn in thin vertical lines.">
  {[0, 1, 2, 3, 4].map((i) => <line x1="16" y1={staffTop + i * staffGap} x2="464" y2={staffTop + i * staffGap} class="staff" />)}
  {contour.map((d) => <path d={d} class="pitch" />)}
  <line x1="16" y1={midY} x2="464" y2={midY} class="axis" />
  {bars.map((b) => <line x1={b.x.toFixed(1)} y1={(midY - b.h).toFixed(1)} x2={b.x.toFixed(1)} y2={(midY + b.h).toFixed(1)} class="bar" />)}
</svg>

<style>
  .figure {
    width: 100%;
    height: auto;
    fill: none;
  }
  .figure :global(*) {
    vector-effect: non-scaling-stroke;
  }
  .staff {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .pitch {
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .bar {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
</style>
